#usda 1.0

(
    defaultPrim = "Wire"
    subLayers = [@../wire_black_s20_r0.001_l1_smooth.usdc@]
)

def Xform "Wire" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
) {
    def Cube "PhysicsProxy" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    ) {
        double size = 0.08
        float3 xformOp:scale = (1.0, 0.12, 0.12)
        token[] xformOpOrder = ["xformOp:scale"]
    }
}
